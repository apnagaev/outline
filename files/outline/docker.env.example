# Скопируйте в docker.env (он в .gitignore) и заполните.
# Полный список параметров: https://github.com/outline/outline/blob/main/.env.sample

NODE_ENV=production

# openssl rand -hex 32
# ВНИМАНИЕ: SECRET_KEY на работающей инсталляции не меняйте — им зашифрованы данные в БД.
SECRET_KEY=CHANGE_ME
UTILS_SECRET=CHANGE_ME

URL=https://wiki.nagaev.biz
PORT=4000
FORCE_HTTPS=true

# --- База и Redis ---
DATABASE_URL=postgres://outline:CHANGE_ME@db.nagaev.biz:5432/outline
PGSSLMODE=disable
REDIS_URL=redis://10.255.253.115:6378/7

# --- Файлы ---
# local хранит вложения на диске узла: /outline/storage должен быть ОБЩИМ для обоих узлов
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000
FILE_STORAGE_IMPORT_MAX_SIZE=512000000
FILE_STORAGE_WORKSPACE_IMPORT_MAX_SIZE=512000000

# --- Вход через Keycloak (redirect URI: https://wiki.nagaev.biz/auth/oidc.callback) ---
OIDC_CLIENT_ID=wiki
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_AUTH_URI=https://sso.nagaev.biz/realms/home/protocol/openid-connect/auth
OIDC_TOKEN_URI=https://sso.nagaev.biz/realms/home/protocol/openid-connect/token
OIDC_USERINFO_URI=https://sso.nagaev.biz/realms/home/protocol/openid-connect/userinfo
OIDC_USERNAME_CLAIM=preferred_username
OIDC_DISPLAY_NAME=SSO Nagaev
OIDC_SCOPES=openid profile email

# --- Почта ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=tech@nagaev.biz
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=wiki@nagaev.biz
SMTP_TLS_CIPHERS=TLSv1.2

# --- Прочее ---
# Примерно 1 процесс на 512 МБ свободной памяти узла; на хосте еще Keycloak и Grist
WEB_CONCURRENCY=2
DEFAULT_LANGUAGE=en_US
LOG_LEVEL=info
ENABLE_UPDATES=true
RATE_LIMITER_ENABLED=true
RATE_LIMITER_REQUESTS=1000
RATE_LIMITER_DURATION_WINDOW=60
