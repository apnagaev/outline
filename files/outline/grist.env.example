# Скопируйте в grist.env (он в .gitignore) и заполните.
# Параметры: https://support.getgrist.com/self-managed/

APP_HOME_URL=https://grist.nagaev.biz
APP_DOC_URL=https://grist.nagaev.biz
GRIST_DOMAIN=nagaev.biz
GRIST_SERVE_SAME_ORIGIN=true
GRIST_SESSION_SECRET=CHANGE_ME
GRIST_SUPPORT_EMAIL=help@nagaev.biz
GRIST_DEFAULT_LOCALE=ru

# --- Доступ ---
GRIST_FORCE_LOGIN=true
GRIST_ANON_PLAYGROUND=false
GRIST_LIST_PUBLIC_SITES=false

# --- Вход через Keycloak ---
GRIST_OIDC_SP_HOST=https://grist.nagaev.biz
GRIST_OIDC_IDP_ISSUER=https://sso.nagaev.biz/realms/home
GRIST_OIDC_IDP_SCOPES=openid profile email
GRIST_OIDC_IDP_CLIENT_ID=grist
GRIST_OIDC_IDP_CLIENT_SECRET=CHANGE_ME

# --- База (home DB) и Redis ---
TYPEORM_TYPE=postgres
TYPEORM_HOST=db.nagaev.biz
TYPEORM_PORT=5432
TYPEORM_DATABASE=grist
TYPEORM_USERNAME=grist
TYPEORM_PASSWORD=CHANGE_ME
TYPEORM_LOGGING=false
REDIS_URL=redis://10.255.253.115:6378/3

# --- Прочее ---
GRIST_SANDBOX_FLAVOR=gvisor
GRIST_EXPERIMENTAL_PLUGINS=true
