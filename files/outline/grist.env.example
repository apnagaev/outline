# Параметры: https://support.getgrist.com/self-managed/

APP_HOME_URL=https://grist.example.org
APP_DOC_URL=https://grist.example.org
GRIST_DOMAIN=example.org
GRIST_SERVE_SAME_ORIGIN=true
GRIST_SESSION_SECRET=secret
GRIST_SUPPORT_EMAIL=help@example.org
GRIST_DEFAULT_LOCALE=ru

# --- Доступ ---
GRIST_FORCE_LOGIN=true
GRIST_ANON_PLAYGROUND=false
GRIST_LIST_PUBLIC_SITES=false

# --- Вход через Keycloak ---
GRIST_OIDC_SP_HOST=https://grist.example.org
GRIST_OIDC_IDP_ISSUER=https://sso.example.org/realms/realm
GRIST_OIDC_IDP_SCOPES=openid profile email
GRIST_OIDC_IDP_CLIENT_ID=grist
GRIST_OIDC_IDP_CLIENT_SECRET=secret

# --- База (home DB) и Redis ---
TYPEORM_TYPE=postgres
TYPEORM_HOST=db.example.org
TYPEORM_PORT=5432
TYPEORM_DATABASE=grist
TYPEORM_USERNAME=grist
TYPEORM_PASSWORD=pass
TYPEORM_LOGGING=false
REDIS_URL=redis://redis:6378/3

# --- Прочее ---
GRIST_SANDBOX_FLAVOR=gvisor
GRIST_EXPERIMENTAL_PLUGINS=true
